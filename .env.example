DISCORD_BOT_TOKEN=
DISCORD_COMMAND_PREFIX=!
SCROLLKEEPER_DATA_DIR=./data
SCROLLKEEPER_BOT_NAME=ScrollKeeper

# OpenAI-compatible endpoints. Base URLs include the /v1 prefix.
# (docker compose overrides the STT URL to point at its own stt service.)
SCROLLKEEPER_STT_BASE_URL=http://localhost:9000/v1
SCROLLKEEPER_STT_MODEL=whisper-1
SCROLLKEEPER_STT_TIMEOUT_SECONDS=600
SCROLLKEEPER_LLM_BASE_URL=http://localhost:8000/v1
SCROLLKEEPER_LLM_MODEL=
SCROLLKEEPER_LLM_API_KEY=
SCROLLKEEPER_LLM_TIMEOUT_SECONDS=900
# Extra JSON merged into every chat request, for server-specific options. For a Qwen3-style
# reasoning model on vLLM, disabling thinking keeps extraction calls short:
# SCROLLKEEPER_LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
SCROLLKEEPER_LLM_EXTRA_BODY=
# Embeddings use POST {base}/embeddings; the base URL defaults to the LLM base URL.
SCROLLKEEPER_EMBED_BASE_URL=
SCROLLKEEPER_EMBED_MODEL=
# Post a "still waiting" notice to Discord when a request takes longer than this (LLM cold start).
SCROLLKEEPER_WAIT_NOTICE_SECONDS=20
# Liveness endpoint (GET /healthz) for Kubernetes probes; 0 disables it.
SCROLLKEEPER_HEALTH_PORT=8080

SCROLLKEEPER_SUMMARY_SINGLE_PASS_MAX_CHARS=90000
SCROLLKEEPER_SUMMARY_CHUNK_CHARS=45000
SCROLLKEEPER_SUMMARY_PROMPT_APPEND=
# Campaign wiki: transcript chunk size for fact extraction, and the Obsidian-style export to data/wiki (0 disables).
SCROLLKEEPER_EXTRACT_CHUNK_CHARS=24000
SCROLLKEEPER_WIKI_EXPORT=1
