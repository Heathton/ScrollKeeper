DISCORD_BOT_TOKEN=
DISCORD_COMMAND_PREFIX=!
SCROLLKEEPER_DATA_DIR=./data
SCROLLKEEPER_BOT_NAME=ScrollKeeper

# OpenAI-compatible endpoints. Base URLs include the /v1 prefix.
# (docker compose overrides the STT URL to point at its own stt service.)
SCROLLKEEPER_STT_BASE_URL=http://localhost:9000/v1
SCROLLKEEPER_STT_MODEL=parakeet-tdt-0.6b-v2
# One call transcribes a whole speaker track, so this must cover the longest track (~9x realtime on CPU).
SCROLLKEEPER_STT_TIMEOUT_SECONDS=7200
SCROLLKEEPER_LLM_BASE_URL=http://localhost:8000/v1
SCROLLKEEPER_LLM_MODEL=
SCROLLKEEPER_LLM_API_KEY=
SCROLLKEEPER_LLM_TIMEOUT_SECONDS=900
# Extra JSON merged into every chat request, for server-specific options. Reasoning models may
# default to very long thinking; with a Qwen3-style chat template on vLLM, set the effort level.
# See "Recommended models and settings" in the README.
# SCROLLKEEPER_LLM_EXTRA_BODY={"chat_template_kwargs": {"reasoning_effort": "medium"}}
SCROLLKEEPER_LLM_EXTRA_BODY=
# Embeddings run in-process on CPU. The model is downloaded once (checksum-verified) into the
# model dir, which defaults to <data dir>/models. Models: embeddinggemma-300m, qwen3-embedding-0.6b.
SCROLLKEEPER_EMBED_MODEL=embeddinggemma-300m
SCROLLKEEPER_EMBED_MODEL_DIR=
SCROLLKEEPER_EMBED_THREADS=2
# Post a "still waiting" notice to Discord when a request takes longer than this (LLM cold start).
SCROLLKEEPER_WAIT_NOTICE_SECONDS=20
# Liveness endpoint (GET /healthz) for Kubernetes probes; 0 disables it.
SCROLLKEEPER_HEALTH_PORT=8080

# The chat model's context length in tokens. Empty or 0 reads it from the server (vLLM reports
# max_model_len on /v1/models), else assumes 32768. Transcripts longer than fits are summarized in
# parts cut at pauses.
SCROLLKEEPER_LLM_CONTEXT_TOKENS=
SCROLLKEEPER_SUMMARY_PROMPT_APPEND=
# Campaign wiki: transcript chunk size for fact extraction, and the Obsidian-style export to data/wiki (0 disables).
SCROLLKEEPER_EXTRACT_CHUNK_CHARS=24000
SCROLLKEEPER_WIKI_EXPORT=1

# Recording. Empty spool = record straight into the data dir. If set, it must be persistent
# (a restart mid-session otherwise loses the audio); tracks move to the data dir for processing.
SCROLLKEEPER_SPOOL_DIR=
# Delete session audio this many days after the summary was written; 0 keeps it forever.
SCROLLKEEPER_AUDIO_RETENTION_DAYS=0

# Journal import (!import-journal): folder rules checked before the built-in defaults, as a JSON
# array of {"folder": "<pattern>", "action": "session|entity|document|name|skip", "type": "<entity type>",
# "entries": "character|handout"}. See "Importing a VTT journal" in the README.
# SCROLLKEEPER_JOURNAL_RULES=[{"folder": "Creatures & Monsters", "action": "name", "type": "Character"}]
SCROLLKEEPER_JOURNAL_RULES=
